# Node 24+. Load with: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Required for initial setup if HOST is not loopback. Choose a long random value.
# SETUP_TOKEN=
# Set only behind HTTPS in production:
# COOKIE_SECURE=true
# Optional AI integration; without a key the deterministic Excel bot works.
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
